rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'Super Admin' ||
        getUserData().roleId == 'role_super_admin'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().status == 'Active'
      );
    }

    function hasPermission(perm) {
      return isSuperAdmin() || (
        isStaff() &&
        getUserData().permissions is list &&
        perm in getUserData().permissions
      );
    }

    function canViewBankDetails() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        hasPermission('drivers.viewBankDetails')
      );
    }

    // Counters collection (used for transaction-based ID generation)
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Settings collection
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read their own profile; staff with users.view can browse
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasPermission('users.view') || isStaff());
      // Super Admin or staff with users.create (preventing ordinary staff from assigning Super Admin)
      allow create: if isSuperAdmin() || (
        hasPermission('users.create') &&
        request.resource.data.role != 'Super Admin' &&
        request.resource.data.roleId != 'role_super_admin'
      ) || request.auth.uid == userId;
      // Super Admin or staff with users.edit (or self profile updates excluding role/permissions/status)
      allow update: if isSuperAdmin() || (
        hasPermission('users.edit') &&
        request.resource.data.role != 'Super Admin' &&
        request.resource.data.roleId != 'role_super_admin'
      ) || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleId', 'status', 'permissions'])
      );
      // Only Super Admin can delete user profile documents
      allow delete: if isSuperAdmin();
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin() || hasPermission('drivers.delete');

      // Subcollection: private bank details
      match /private/{document=**} {
        allow read: if canViewBankDetails();
        allow write: if isSuperAdmin();
      }
    }

    // Deliveries collection
    match /deliveries/{deliveryId} {
      allow read: if isStaff();
      allow create: if isStaff() && (hasPermission('deliveries.create') || hasPermission('deliveries'));
      allow update: if isStaff() && (hasPermission('deliveries.edit') || hasPermission('deliveries'));
      allow delete: if isSuperAdmin() || hasPermission('deliveries.delete');
    }

    // Payment Requests collection
    match /paymentRequests/{requestId} {
      allow read: if isStaff();
      allow create: if isStaff() && (hasPermission('payments.create') || hasPermission('paymentRequests'));
      allow update: if isStaff() && (hasPermission('payments.edit') || hasPermission('payments.approvePayments') || hasPermission('paymentRequests'));
      allow delete: if isSuperAdmin() || hasPermission('payments.voidPayments');
    }

    // Payments collection (paymentHistory) - Audit locked
    match /paymentHistory/{paymentId} {
      allow read: if isStaff();
      allow create: if isStaff() && (hasPermission('payments.create') || hasPermission('paymentHistory'));
      allow update: if isStaff() && (hasPermission('payments.edit') || hasPermission('paymentHistory'));
      allow delete: if false; // Audit-locked: settlement transactions cannot be hard-deleted
    }
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create: if isStaff() && (hasPermission('payments.create') || hasPermission('payments'));
      allow update: if isStaff() && (hasPermission('payments.edit') || hasPermission('payments'));
      allow delete: if false; // Audit-locked
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isStaff();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Saved Reports collection
    match /savedReports/{reportId} {
      allow read, write: if isStaff();
      allow delete: if isSuperAdmin() || hasPermission('reports');
    }

    // Audit Logs collection (Immutable: strictly append-only, read by Super Admin)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
